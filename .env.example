APP_NAME=Pulse
APP_ENV=local
# Gere com: docker compose exec app php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL do docker-compose (serviço "db"). Fora do Docker, troque DB_HOST por 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pulse
DB_USERNAME=pulse
DB_PASSWORD=pulse

# Sessões e cache no banco; sem fila, worker nem Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE: sem definir, vale true com APP_ENV=production e false fora dela (config/session.php).

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
